{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "pull-request-header": "Release ready for review.",
  "pull-request-footer": " ",
  "include-component-in-tag": false,
  "bootstrap-sha": "8d4fa9f9ae1765d384bbe71cae873759fe17f75f",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "bhyve_ble",
      "extra-files": [
        {
          "type": "json",
          "path": "custom_components/bhyve_ble/manifest.json",
          "jsonpath": "$.version"
        },
        {
          "type": "toml",
          "path": "custom_components/bhyve_ble/pyproject.toml",
          "jsonpath": "$.project.version"
        },
        {
          "type": "generic",
          "path": "custom_components/bhyve_ble/pybhyve/__init__.py"
        },
        {
          "type": "generic",
          "path": ".github/ISSUE_TEMPLATE/bug.yml"
        }
      ]
    }
  }
}
